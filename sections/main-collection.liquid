<section class="section collection-section">
  <div class="container">
    <header class="collection-head center">
      {%- comment -%} L'override de titre ne vaut que pour la collection « all » (le catalogue) ; les collections spécifiques gardent leur vrai nom {%- endcomment -%}
      {%- assign coll_heading = collection.title -%}
      {%- if collection.handle == 'all' and section.settings.heading != blank -%}{%- assign coll_heading = section.settings.heading -%}{%- endif -%}
      {%- if section.settings.kicker != blank -%}<p class="kicker center">{{ section.settings.kicker }}</p>{%- endif -%}
      <h1>{{ coll_heading }}</h1>
      {%- if collection.description != blank -%}<div class="lead rte">{{ collection.description }}</div>{%- endif -%}
    </header>

    {%- comment -%}
      Filtres marque/type/tag = NATIFS Shopify (collection.filters) → toutes les valeurs, tous
      comptés, filtrage serveur qui scale. Rehaussés en AJAX (Section Rendering API) dans theme.js
      pour une mise à jour fluide sans rechargement ; sans JS le <form> se soumet normalement.
      Recherche + tri restent client-side (affinent le résultat déjà filtré, gardent le tri « remise »).
    {%- endcomment -%}
    <div id="CollSection" data-section-id="{{ section.id }}" data-coll-url="{{ collection.url }}">
      {%- if collection.all_products_count == 0 -%}
        <div class="empty-state center">
          <p class="lead">{{ section.settings.empty_label }}</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn-dark">{{ section.settings.empty_cta }}</a>
        </div>
      {%- else -%}
        {%- paginate collection.products by 52 -%}
          <div id="CollResults">
            {%- comment -%} Filtre marque = pastilles avec logo ; les autres filtres restent en select {%- endcomment -%}
            {%- assign vendor_filter = null -%}
            {%- assign has_active = false -%}
            {%- for f in collection.filters -%}
              {%- if f.param_name == 'filter.p.vendor' -%}{%- assign vendor_filter = f -%}{%- endif -%}
              {%- if f.active_values.size > 0 -%}{%- assign has_active = true -%}{%- endif -%}
            {%- endfor -%}
            {%- assign active_vendor = '' -%}
            {%- if vendor_filter -%}{%- for v in vendor_filter.values -%}{%- if v.active -%}{%- assign active_vendor = v.value -%}{%- endif -%}{%- endfor -%}{%- endif -%}

            {%- if vendor_filter and vendor_filter.values.size > 0 -%}
              <div class="brand-chips" role="group" aria-label="{{ vendor_filter.label | escape }}">
                {%- for v in vendor_filter.values -%}
                  <button type="button" class="brand-chip{% if v.active %} active{% endif %}" data-vendor="{{ v.value | escape }}" aria-pressed="{% if v.active %}true{% else %}false{% endif %}">
                    {% render 'brand-logo', brand: v.value, size: 26 %}
                    <span class="brand-chip-name">{{ v.label }}</span>
                    <span class="brand-chip-count">{{ v.count }}</span>
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}

            <div class="cat-bar">
              {%- if section.settings.show_search -%}
                <div class="cat-search">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
                  <input type="search" id="CollSearch" placeholder="{{ section.settings.search_placeholder | escape }}" aria-label="{{ section.settings.search_placeholder | escape }}">
                </div>
              {%- endif -%}

              <div class="cat-tools">
                <span class="cat-count"><span id="CollCount">{{ paginate.items }}</span> {{ section.settings.count_label }}</span>

                {%- comment -%} Facettes natives : marque, type, tag… (selon ce qui est activé dans Search & Discovery) {%- endcomment -%}
                <form method="get" id="CollFilters" class="cat-filters">
                  {%- if vendor_filter -%}<input type="hidden" name="filter.p.vendor" id="VendorInput" value="{{ active_vendor | escape }}">{%- endif -%}
                  {%- for filter in collection.filters -%}
                    {%- if filter.param_name != 'filter.p.vendor' and filter.type == 'list' and filter.values.size > 0 -%}
                      <select class="cat-select" name="{{ filter.param_name }}" data-native aria-label="{{ filter.label | escape }}" onchange="if(!window.__collAjax){this.form.submit();}">
                        <option value="">{{ filter.label }}</option>
                        {%- for v in filter.values -%}
                          <option value="{{ v.value | escape }}"{% if v.active %} selected{% endif %}>{{ v.label }}{% if v.count > 0 %} ({{ v.count }}){% endif %}</option>
                        {%- endfor -%}
                      </select>
                    {%- endif -%}
                  {%- endfor -%}
                </form>

                {%- if section.settings.show_sort -%}
                  <select id="CollSort" class="cat-select" aria-label="{{ section.settings.sort_label | escape }}">
                    <option value="featured">{{ section.settings.sort_featured }}</option>
                    <option value="price-asc">{{ section.settings.sort_price_asc }}</option>
                    <option value="price-desc">{{ section.settings.sort_price_desc }}</option>
                    <option value="discount">{{ section.settings.sort_discount }}</option>
                  </select>
                {%- endif -%}

                <a href="{{ collection.url }}" class="cat-reset" id="CollReset"{% unless has_active %} hidden{% endunless %}>{{ section.settings.reset_label }}</a>
              </div>
            </div>

            {%- if collection.products.size > 0 -%}
              <div class="product-grid" id="CollGrid">
                {%- for product in collection.products -%}
                  {% render 'product-card', product: product %}
                {%- endfor -%}
              </div>
              <p class="collection-none center lead" id="CollNone" hidden>{{ section.settings.none_label }}</p>

              {%- if paginate.pages > 1 -%}
                <nav class="pagination" aria-label="Pagination">
                  {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="btn btn-ghost btn-sm">&larr; {{ 'general.pagination.previous' | t }}</a>{%- else -%}<span></span>{%- endif -%}
                  <span class="pagination-count">{{ paginate.current_page }} / {{ paginate.pages }}</span>
                  {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="btn btn-ghost btn-sm">{{ 'general.pagination.next' | t }} &rarr;</a>{%- else -%}<span></span>{%- endif -%}
                </nav>
              {%- endif -%}
            {%- else -%}
              <p class="collection-none center lead">{{ section.settings.none_label }} · <a href="{{ collection.url }}">{{ section.settings.reset_label }}</a></p>
            {%- endif -%}
          </div>
        {%- endpaginate -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Sourced in Paris" },
    { "type": "text", "id": "heading", "label": "Heading — only overrides the « all » catalogue title", "default": "The catalogue" },
    { "type": "header", "content": "Filters" },
    { "type": "paragraph", "content": "Brand / type / tag filters are native Shopify filters — enable them in Online Store → Search & Discovery → Filters. Search & sort below stay instant (client-side)." },
    { "type": "checkbox", "id": "show_search", "label": "Search box", "default": true },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search a product…" },
    { "type": "checkbox", "id": "show_sort", "label": "Sort dropdown", "default": true },
    { "type": "text", "id": "sort_label", "label": "Sort aria-label", "default": "Sort" },
    { "type": "text", "id": "sort_featured", "label": "Sort — featured", "default": "Featured" },
    { "type": "text", "id": "sort_price_asc", "label": "Sort — price ascending", "default": "Price ↑" },
    { "type": "text", "id": "sort_price_desc", "label": "Sort — price descending", "default": "Price ↓" },
    { "type": "text", "id": "sort_discount", "label": "Sort — biggest discount", "default": "Biggest discount" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "count_label", "label": "Count label", "default": "pieces" },
    { "type": "text", "id": "reset_label", "label": "Reset label", "default": "Reset filters" },
    { "type": "text", "id": "none_label", "label": "No search result", "default": "No match — try another brand or keyword." },
    { "type": "text", "id": "empty_label", "label": "Empty collection message", "default": "No products in this collection yet." },
    { "type": "text", "id": "empty_cta", "label": "Empty CTA label", "default": "Browse all products" }
  ]
}
{% endschema %}
