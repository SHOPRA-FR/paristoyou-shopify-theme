{%- comment -%}
  Annuaire des marques disponibles — La Vallée Village & Val d'Europe.
  Une ligne = Nom|lavallee/valdeurope|host|logo.
  logo : vide = favicon Google (auto depuis le host) · "-" = initiales stylisées
         · une URL = logo explicite (prioritaire). Voir scraper/build-brand-directory.py.
  Recherche + filtre par centre gérés par theme.js (BrandsGrid/BrandSearch/BrandFilters).
  Chaque carte ouvre le site officiel de la marque (nouvel onglet) : le client
  y choisit ses articles puis colle les liens dans My List.
{%- endcomment -%}

{%- capture nl %}
{% endcapture -%}
{%- assign lines = section.settings.brands | strip | split: nl -%}

{%- assign n_total = 0 -%}
{%- assign n_lv = 0 -%}
{%- assign n_ve = 0 -%}
{%- for line in lines -%}
  {%- assign parts = line | strip | split: '|' -%}
  {%- if parts[0] == blank -%}{% continue %}{%- endif -%}
  {%- assign n_total = n_total | plus: 1 -%}
  {%- assign mall = parts[1] | strip | downcase -%}
  {%- if mall == 'lavallee' -%}{%- assign n_lv = n_lv | plus: 1 -%}
  {%- elsif mall == 'valdeurope' -%}{%- assign n_ve = n_ve | plus: 1 -%}{%- endif -%}
{%- endfor -%}

<section class="section brand-directory" id="brands">
  <div class="container">
    {%- if section.settings.kicker != blank -%}<p class="kicker center">{{ section.settings.kicker }}</p>{%- endif -%}
    <h1 class="center">{{ section.settings.title }}</h1>
    {%- if section.settings.subtitle != blank -%}<p class="lead center">{{ section.settings.subtitle }}</p>{%- endif -%}

    <div class="catalog-toolbar">
      <input type="search" id="BrandSearch" class="catalog-search" placeholder="{{ section.settings.search_ph | escape }}" aria-label="{{ section.settings.search_ph | escape }}">
      <div class="catalog-pills" id="BrandFilters">
        <button type="button" data-mall="all" class="active">{{ section.settings.label_all }} ({{ n_total }})</button>
        <button type="button" data-mall="lavallee">{{ section.settings.label_lavallee }} ({{ n_lv }})</button>
        <button type="button" data-mall="valdeurope">{{ section.settings.label_valdeurope }} ({{ n_ve }})</button>
      </div>
    </div>

    <div class="brands-grid" id="BrandsGrid">
      {%- for line in lines -%}
        {%- assign parts = line | strip | split: '|' -%}
        {%- assign bname = parts[0] | strip -%}
        {%- if bname == blank -%}{% continue %}{%- endif -%}
        {%- assign mall = parts[1] | strip | downcase -%}
        {%- assign bdomain = parts[2] | strip -%}
        {%- assign blogo = parts[3] | strip -%}
        {%- comment -%} logo vide → favicon Google reconstruit depuis le host ; '-' → initiales ; sinon URL explicite {%- endcomment -%}
        {%- if blogo == '-' -%}
          {%- assign logo_src = '' -%}
        {%- elsif blogo != blank -%}
          {%- assign logo_src = blogo -%}
        {%- elsif bdomain != blank -%}
          {%- assign logo_src = 'https://www.google.com/s2/favicons?domain=' | append: bdomain | append: '&sz=128' -%}
        {%- else -%}
          {%- assign logo_src = '' -%}
        {%- endif -%}
        {%- if mall == 'valdeurope' -%}
          {%- assign mall_label = section.settings.label_valdeurope -%}
        {%- else -%}
          {%- assign mall_label = section.settings.label_lavallee -%}
        {%- endif -%}

        {%- comment -%} Génère les initiales (2-3 lettres) à partir du nom {%- endcomment -%}
        {%- assign words = bname | split: ' ' -%}
        {%- assign initials = '' -%}
        {%- for word in words limit: 3 -%}
          {%- assign ch = word | slice: 0, 1 -%}
          {%- if ch != '&' and ch != '-' and ch != ',' and ch != '.' and ch != '(' and ch != '·' -%}
            {%- assign initials = initials | append: ch -%}
          {%- endif -%}
        {%- endfor -%}
        {%- assign mono_class = 'mono-' | append: initials.size -%}

        {%- if bdomain != blank -%}
          <a class="brand-card" href="https://{{ bdomain }}" target="_blank" rel="noopener nofollow"
             data-mall="{{ mall }}" data-name="{{ bname | downcase | escape }}"
             aria-label="{{ bname | escape }} — {{ section.settings.card_cta | escape }}">
        {%- else -%}
          <div class="brand-card" data-mall="{{ mall }}" data-name="{{ bname | downcase | escape }}">
        {%- endif -%}
            {%- if logo_src != blank -%}
              <img class="brand-card-logo" src="{{ logo_src | escape }}" alt="{{ bname | escape }}" width="38" height="38" loading="lazy"
                   onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
            {%- endif -%}
            <span class="brand-card-mono {{ mono_class }}" aria-hidden="true"{% if logo_src != blank %} style="display:none;"{% endif %}>{{ initials }}</span>
            <span class="brand-card-name">{{ bname }}</span>
            <span class="brand-card-mall">{{ mall_label }}</span>
            {%- if bdomain != blank -%}<span class="brand-card-site">{{ section.settings.card_cta }} ↗</span>{%- endif -%}
        {%- if bdomain != blank -%}</a>{%- else -%}</div>{%- endif -%}
      {%- endfor -%}
    </div>
    <p class="brands-none" id="BrandsNone" hidden>{{ section.settings.none_label }}</p>

    {%- if section.settings.note != blank -%}
      <p class="brands-wall-note center">{{ section.settings.note }}</p>
    {%- endif -%}
    {%- if section.settings.cta_label != blank -%}
      <p class="center sel-cta"><a href="{{ section.settings.cta_link | default: '/pages/my-list' }}" class="btn btn-dark">{{ section.settings.cta_label }}</a></p>
    {%- endif -%}
  </div>
</section>

