<section class="password-page">
  <div class="password-inner">
    <a href="{{ routes.root_url }}" class="logo">{{ settings.logo_text }}</a>
    <p class="password-tagline">{{ settings.tagline }}</p>

    <h1 class="password-h1">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}
      <p class="password-sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- form 'storefront_password' -%}
      {%- if form.errors -%}
        <p class="password-error">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
      {%- endif -%}
      <div class="password-field">
        <input type="password" name="password" id="Password" placeholder="{{ section.settings.placeholder }}" autocomplete="current-password" required>
        <button type="submit" class="btn btn-accent">{{ section.settings.button_label }}</button>
      </div>
    {%- endform -%}

    <p class="password-note">{{ section.settings.note }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Luxury personal shopping from Paris's finest outlets — delivered across Europe and worldwide." },
    { "type": "text", "id": "placeholder", "label": "Field placeholder", "default": "Enter password" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Enter" },
    { "type": "text", "id": "note", "label": "Note", "default": "Are you the store owner? Log in to your admin." }
  ]
}
{% endschema %}
