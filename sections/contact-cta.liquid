<section class="section" id="contact">
  <div class="container center">
    <h2>{{ section.settings.title }}</h2>

    {%- if customer -%}
      <p style="color:var(--muted);font-weight:300;margin:16px 0 32px;font-size:.95rem;">{{ section.settings.subtitle }}</p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        {%- assign wa = settings.whatsapp_number | remove: '+' | remove: ' ' -%}
        {%- if wa != blank -%}
          <a href="https://wa.me/{{ wa }}" class="btn" target="_blank" rel="noopener">{{ section.settings.wa_label }}</a>
        {%- endif -%}
        {%- if settings.instagram_url != blank -%}
          <a href="{{ settings.instagram_url }}" class="btn" target="_blank" rel="noopener">Instagram</a>
        {%- endif -%}
        <a href="/pages/contact" class="btn">Email</a>
      </div>
    {%- else -%}
      <p style="color:var(--muted);font-weight:300;margin:16px 0 32px;font-size:.95rem;">
        {{ section.settings.auth_message | default: 'Please sign in or create an account to contact us.' }}
      </p>
      <div style="display:flex;gap:16px;justify-content:center;flex-wrap:wrap;">
        <a href="{{ routes.account_login_url }}" class="btn btn-dark">
          {{ section.settings.auth_cta_label | default: 'Sign in' }}
        </a>
        <a href="{{ routes.account_register_url }}" class="btn">
          {{ section.settings.auth_register_label | default: 'Create an account' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Contact CTA",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Book your appointment" },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Limited slots per week. Tell me what you're looking for." },
    { "type": "text", "id": "wa_label", "label": "WhatsApp", "default": "WhatsApp" },
    { "type": "text", "id": "auth_message", "label": "Message (non connecté)", "default": "Please sign in or create an account to contact us." },
    { "type": "text", "id": "auth_cta_label", "label": "Bouton Connexion", "default": "Sign in" },
    { "type": "text", "id": "auth_register_label", "label": "Bouton Inscription", "default": "Create an account" }
  ],
  "presets": [{ "name": "Contact CTA" }]
}
{% endschema %}
