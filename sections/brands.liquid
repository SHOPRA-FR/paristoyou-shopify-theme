{%- comment -%}
  Brands — mur de logos en défilement vertical (colonnes alternées montantes/
  descendantes). Chaque tuile est cliquable vers le SITE OFFICIEL de la marque
  (nouvel onglet). Logos chargés via l'API publique Clearbit à partir du domaine
  officiel, avec repli monogramme si indisponible.
  Ligne de réglage : Nom|https://site-officiel|lavallee ou valdeurope
{%- endcomment -%}

<section class="section section-alt brands-wall-section" id="brands">
  <div class="container">
    {%- if section.settings.kicker != blank -%}<p class="kicker center">{{ section.settings.kicker }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="center">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.subtitle != blank -%}<p class="lead center">{{ section.settings.subtitle }}</p>{%- endif -%}
  </div>

  {%- capture nl %}
{% endcapture -%}
  {%- assign lines = section.settings.brands | strip | split: nl -%}
  {%- assign cols = section.settings.columns -%}

  <div class="brands-wall" style="--wall-h:{{ section.settings.height }}px;--wall-speed:{{ section.settings.speed }}s">
    {%- assign col_max = cols | minus: 1 -%}
    {%- for col in (0..col_max) -%}
      <div class="wall-col {% cycle 'down', 'up' %}">
        <div class="wall-track">
          {%- for rep in (1..2) -%}
            {%- for line in lines -%}
              {%- assign idx = forloop.index0 | modulo: cols -%}
              {%- if idx != col -%}{% continue %}{%- endif -%}
              {%- assign parts = line | strip | split: '|' -%}
              {%- assign bname = parts[0] | strip -%}
              {%- if bname == blank -%}{% continue %}{%- endif -%}
              {%- assign burl = parts[1] | strip -%}
              {%- assign bdomain = burl | remove: 'https://' | remove: 'http://' | remove: 'www.' | split: '/' | first -%}
              <a class="wall-tile" href="{{ burl }}" target="_blank" rel="noopener nofollow"
                 aria-label="{{ bname | escape }} — official website">
                <img src="https://www.google.com/s2/favicons?domain={{ bdomain }}&amp;sz=64" alt="{{ bname | escape }}"
                     width="48" height="48"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
                <span class="wall-mono" style="display:none">{{ bname | slice: 0, 1 }}</span>
                <span class="wall-name">{{ bname }}</span>
              </a>
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
    <div class="wall-fade top" aria-hidden="true"></div>
    <div class="wall-fade bottom" aria-hidden="true"></div>
  </div>

  {%- if section.settings.note != blank -%}
    <div class="container"><p class="brands-wall-note center">{{ section.settings.note }}</p></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Brands logo wall",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The brands" },
    { "type": "text", "id": "title", "label": "Title", "default": "120+ luxury & fashion brands" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Tap any brand to open its official website, pick your items, then paste the links into your list." },
    { "type": "textarea", "id": "note", "label": "Bottom note", "default": "Brands from La Vallée Village (luxury outlet) and Val d'Europe, Paris. No official affiliation — I buy on your behalf in the official boutiques." },
    { "type": "range", "id": "columns", "min": 3, "max": 8, "step": 1, "label": "Columns", "default": 6 },
    { "type": "range", "id": "height", "min": 320, "max": 720, "step": 40, "unit": "px", "label": "Wall height", "default": 520 },
    { "type": "range", "id": "speed", "min": 20, "max": 90, "step": 5, "unit": "s", "label": "Scroll duration (higher = slower)", "default": 55 },
