<section class="section">
  <div class="container">
    <h1 class="center">{{ 'general.search.search' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search-form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.search' | t }}…" aria-label="{{ 'general.search.search' | t }}">
      <button type="submit" class="btn btn-dark">{{ 'general.search.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- paginate search.results by 24 -%}
        {%- if search.results.size > 0 -%}
          <div class="product-grid">
            {%- for item in search.results -%}
              {%- if item.object_type == 'product' -%}
                {% render 'product-card', product: item %}
              {%- else -%}
                <a class="brand-card" href="{{ item.url }}"><span class="brand-name">{{ item.title }}</span></a>
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <nav class="pagination">
              {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
              <span>{{ paginate.current_page }} / {{ paginate.pages }}</span>
              {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- else -%}
          <p class="center lead empty-state">No results for “{{ search.terms | escape }}”.</p>
        {%- endif -%}
      {%- endpaginate -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Search", "settings": [] }
{% endschema %}
