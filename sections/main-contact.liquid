{%- comment -%}
  Contact — réservé aux clients connectés (anti-spam, choix assumé).
  Connecté : formulaire email natif Shopify + bouton WhatsApp + contact direct.
  Non connecté : sas de connexion / création de compte.
{%- endcomment -%}

<section class="section contact-page">
  <div class="container">
    <header class="contact-head center">
      {%- if section.settings.kicker != blank -%}<p class="kicker center">{{ section.settings.kicker }}</p>{%- endif -%}
      <h1>{{ section.settings.title }}</h1>
      {%- if section.settings.subtitle != blank -%}<p class="lead">{{ section.settings.subtitle }}</p>{%- endif -%}
    </header>

      <div class="contact-grid">
        {%- comment -%} Formulaire email — visible par tous, envoi réservé aux membres {%- endcomment -%}
        <div class="contact-form-col">
          {%- form 'contact', id: 'ContactForm' -%}
            {%- if form.posted_successfully? -%}
              <p class="contact-success">✓ {{ section.settings.success_message }}</p>
            {%- elsif form.errors -%}
              <div class="contact-errors">{{ form.errors | default_errors }}</div>
            {%- endif -%}

            <fieldset class="contact-fields"{% unless customer %} disabled{% endunless %}>
              <label class="field-label" for="ContactName">{{ section.settings.label_name }}</label>
              <input type="text" id="ContactName" name="contact[name]" value="{{ customer.name }}" autocomplete="name" required>

              <div class="contact-form-row">
                <div>
                  <label class="field-label" for="ContactEmail">{{ section.settings.label_email }}</label>
                  <input type="email" id="ContactEmail" name="contact[email]" value="{{ customer.email }}" autocomplete="email" required>
                </div>
                <div>
                  <label class="field-label" for="ContactPhone">{{ section.settings.label_phone }}</label>
                  <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ customer.phone }}" autocomplete="tel">
                </div>
              </div>

              <label class="field-label" for="ContactBody">{{ section.settings.label_message }}</label>
              <textarea id="ContactBody" name="contact[body]" rows="5" required placeholder="{{ section.settings.message_placeholder | escape }}"></textarea>
            </fieldset>

            {%- if customer -%}
              <button type="submit" class="btn btn-dark btn-block">{{ section.settings.label_send }}</button>
            {%- else -%}
              <div class="locked-block" style="margin-top:24px">
                <p>{{ section.settings.auth_message }}</p>
                <a href="{{ routes.account_login_url }}" class="btn btn-dark btn-block">{{ section.settings.auth_cta_label }}</a>
                <a href="{{ routes.account_register_url }}" class="btn btn-ghost btn-block">{{ section.settings.auth_register_label }}</a>
                {%- if section.settings.gate_note != blank -%}<p class="contact-gate-note">{{ section.settings.gate_note }}</p>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endform -%}
        </div>

        {%- comment -%} WhatsApp / contact direct {%- endcomment -%}
        <aside class="contact-side">
          <h3>{{ section.settings.side_title }}</h3>
          <p>{{ section.settings.side_text }}</p>

          {%- if customer -%}
            {%- assign wa = settings.whatsapp_number | remove: '+' | remove: ' ' -%}
            {%- if wa != blank -%}
              {%- assign wa_text = section.settings.wa_prefill | default: '' | url_encode -%}
              <a href="https://wa.me/{{ wa }}{% if wa_text != blank %}?text={{ wa_text }}{% endif %}" class="btn btn-wa btn-block" target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M.057 24l1.687-6.163a11.87 11.87 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.477-.227z"/></svg>
                {{ section.settings.wa_label }}
              </a>
            {%- endif -%}
          {%- else -%}
            {%- comment -%} Invités : le numéro reste privé — le bouton mène à la connexion {%- endcomment -%}
            <a href="{{ routes.account_login_url }}" class="btn btn-ghost btn-block">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              {{ section.settings.guest_wa_label }}
            </a>
          {%- endif -%}

          <div class="contact-direct-list">
            {%- if customer and settings.contact_email != blank -%}
              <a href="mailto:{{ settings.contact_email }}" class="contact-direct">{{ settings.contact_email }}</a>
            {%- endif -%}
            {%- if settings.instagram_url != blank -%}
              <a href="{{ settings.instagram_url }}" class="contact-social" target="_blank" rel="noopener">Instagram ↗</a>
            {%- endif -%}
          </div>

          {%- if section.settings.hours_note != blank -%}
            <p class="contact-hours">{{ section.settings.hours_note }}</p>
          {%- endif -%}
        </aside>
      </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Get in touch" },
    { "type": "text", "id": "title", "label": "Title", "default": "Contact your personal shopper" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "Tell me what you're looking for — I'll get back to you personally." },
    { "type": "header", "content": "Email form" },
    { "type": "text", "id": "label_name", "label": "Name label", "default": "Your name" },
    { "type": "text", "id": "label_email", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "label_phone", "label": "Phone label", "default": "Phone (optional)" },
    { "type": "text", "id": "label_message", "label": "Message label", "default": "What are you looking for?" },
    { "type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "Brand, item, size, budget…" },
    { "type": "text", "id": "label_send", "label": "Send button", "default": "Send message" },
    { "type": "textarea", "id": "success_message", "label": "Success message", "default": "Thanks — your message has been sent. I'll reply by email shortly." },
    { "type": "header", "content": "WhatsApp / direct" },
    { "type": "text", "id": "side_title", "label": "Side title", "default": "Prefer WhatsApp?" },
    { "type": "textarea", "id": "side_text", "label": "Side text", "default": "For a faster reply, message me directly — photos and live prices from the outlets." },
    { "type": "text", "id": "wa_label", "label": "WhatsApp button", "default": "Message on WhatsApp" },
    { "type": "text", "id": "guest_wa_label", "label": "WhatsApp button (guests)", "default": "Sign in to unlock WhatsApp" },
    { "type": "textarea", "id": "wa_prefill", "label": "WhatsApp prefilled text", "default": "Hi! I'm a member and I'd like some help sourcing an item." },
    { "type": "textarea", "id": "hours_note", "label": "Response time note", "default": "Usually replies within a few hours, Mon–Sat." },
    { "type": "header", "content": "Not signed in (page visible, sending locked)" },
    { "type": "textarea", "id": "auth_message", "label": "Locked message", "default": "To send your message, sign in or create a free account." },
    { "type": "text", "id": "auth_cta_label", "label": "Sign-in button", "default": "Sign in" },
    { "type": "text", "id": "auth_register_label", "label": "Register button", "default": "Create a free account" },
    { "type": "textarea", "id": "gate_note", "label": "Locked note", "default": "Free and takes a minute — it keeps our conversations organised and spam-free." }
  ]
}
{% endschema %}
