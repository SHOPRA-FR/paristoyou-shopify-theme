<header class="site-header" id="SiteHeader">
  {%- assign links = linklists[section.settings.menu].links -%}

  {%- comment -%} Ligne 1 : burger (mobile) · logo centré · compte + panier {%- endcomment -%}
  <div class="header-bar">
    <button class="burger" id="Burger" aria-label="Menu" aria-expanded="false" aria-controls="MainNav">
      <span></span><span></span><span></span>
    </button>

    {%- comment -%} Sélecteur de langue tout à gauche (desktop) ; caché en mobile où il vit dans le menu {%- endcomment -%}
    <div class="header-lang">{%- render 'language-selector', place: 'topbar' -%}</div>

    <a href="{{ routes.root_url }}" class="logo">
      {%- if settings.logo_image != blank -%}
        <img src="{{ settings.logo_image | image_url: width: 320 }}" alt="{{ shop.name | escape }}" width="160" height="34" loading="eager">
      {%- else -%}
        {{ settings.logo_text }}
      {%- endif -%}
    </a>

    <div class="header-actions">
      {%- comment -%} Icône compte : uniquement quand le client est connecté {%- endcomment -%}
      {%- if customer -%}
        <a href="{{ routes.account_url }}" class="header-account-link" title="{{ 'customer.account.title' | t }}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        </a>
      {%- endif -%}

      <a href="{{ routes.cart_url }}" class="header-cart" aria-label="{{ 'cart.general.title' | t }}">
        <span class="header-cart-label">{{ 'cart.general.title' | t }}</span>
        <svg class="header-cart-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
        <span class="cart-count">({{ cart.item_count }})</span>
      </a>
    </div>
  </div>

  {%- comment -%} Ligne 2 : barre de navigation dédiée, tous les liens centrés {%- endcomment -%}
  <nav class="main-nav" id="MainNav">
    {%- for link in links -%}
      {%- comment -%} Client connecté : on masque le lien d'inscription/compte (Sign Up) {%- endcomment -%}
      {%- if customer -%}
        {%- assign lurl = link.url | downcase -%}
        {%- assign sm = section.settings.signup_match | downcase | strip -%}
        {%- if lurl contains '/account' -%}{% continue %}{%- endif -%}
        {%- if sm != blank and lurl contains sm -%}{% continue %}{%- endif -%}
      {%- endif -%}
      <a href="{{ link.url }}"{% if link.active %} class="is-active" aria-current="page"{% endif %}>{{ link.title }}</a>
    {%- endfor -%}
    {%- comment -%} Accès compte dans le menu déroulant mobile : seulement si connecté {%- endcomment -%}
    {%- if customer -%}
      <a href="{{ routes.account_url }}" class="nav-account-mobile">{{ 'customer.account.title' | t }}</a>
    {%- endif -%}
    {%- comment -%} Sélecteur de langue dans le menu mobile {%- endcomment -%}
    {%- if localization.available_languages.size > 1 -%}
      <div class="nav-lang-mobile">{% render 'language-selector', place: 'header' %}</div>
    {%- endif -%}
  </nav>
</header>

<script>
  (function(){
    var h = document.getElementById('SiteHeader');
    window.addEventListener('scroll', function(){
      h.classList.toggle('scrolled', window.scrollY > 40);
    }, { passive: true });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "signup_match", "label": "Lien Sign Up — masqué une fois connecté (fragment d'URL)", "info": "Le lien du menu dont l'URL contient ce texte disparaît quand le client est connecté. Ex. « profil » pour /pages/profil.", "default": "profil" }
  ]
}
{% endschema %}
