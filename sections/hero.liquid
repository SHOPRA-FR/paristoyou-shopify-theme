{%- comment -%}
  Hero — Éditorial luxe. Titre massif + composition image (arche + collage).
{%- endcomment -%}

<section class="hero">
  {%- if section.settings.show_products_bg -%}
    {%- assign bgcoll = section.settings.bg_collection -%}
    {%- if bgcoll == blank -%}{%- assign bgcoll = collections.all -%}{%- endif -%}
    {%- if bgcoll.products_count > 0 -%}
      <div class="hero-bg" aria-hidden="true">
        {%- assign products1 = bgcoll.products | sort: 'published_at' | reverse -%}
        {%- assign products2 = bgcoll.products | sort: 'published_at' -%}
        <div class="hero-bg-track" style="--marquee-speed:{{ section.settings.marquee_speed }}s">
          {%- for i in (1..2) -%}
            {%- for product in products1 limit: 8 -%}
              {%- if product.featured_image -%}
                <span class="hero-bg-item"><img src="{{ product.featured_image | image_url: width: 240 }}" alt="" width="160" height="213" loading="lazy"></span>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
        <div class="hero-bg-track hero-bg-track--rev" style="--marquee-speed:{{ section.settings.marquee_speed | times: 1.3 }}s">
          {%- for i in (1..2) -%}
            {%- for product in products2 limit: 8 -%}
              {%- if product.featured_image -%}
                <span class="hero-bg-item"><img src="{{ product.featured_image | image_url: width: 240 }}" alt="" width="160" height="213" loading="lazy"></span>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  <div class="hero-inner">
    {%- if section.settings.kicker != blank -%}
      <p class="kicker center">{{ section.settings.kicker }}</p>
    {%- endif -%}

    {%- assign title_formatted = section.settings.title | replace: 'Paris', '<span class="hero-title-accent">Paris</span>' | replace: 'to you.', '<span class="hero-title-accent">to you.</span>' | replace: 'to you', '<span class="hero-title-accent">to you</span>' -%}
    <h1 class="hero-title">{{ title_formatted | newline_to_br }}</h1>

    <hr class="hero-rule" aria-hidden="true">

    {%- if section.settings.subtitle != blank -%}
      <p class="hero-subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank -%}
      <a
        href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}"
        class="hero-cta-btn"
      >
        {{- section.settings.cta_label -}}
        <svg class="hero-cta-arrow" viewBox="0 0 16 16" width="16" height="16"
             fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M6 3l5 5-5 5"/>
        </svg>
      </a>
    {%- endif -%}
  </div>

  {%- if section.settings.show_brands_marquee and section.settings.brands_list != blank -%}
    <div class="hero-marquee" aria-hidden="true">
      <div class="hero-marquee-track" style="--marquee-speed:{{ section.settings.marquee_speed }}s">
        {%- capture nl %}
{% endcapture -%}
        {%- comment -%} Format partagé avec la page Brands : Nom|host|logo
             (logo vide = favicon Google auto · '-' = pas de logo · URL = logo explicite). {%- endcomment -%}
        {%- assign brand_lines = section.settings.brands_list | strip | split: nl -%}
        {%- for i in (1..2) -%}
          {%- for line in brand_lines -%}
            {%- assign parts = line | strip | split: '|' -%}
            {%- assign bname = parts[0] | strip -%}
            {%- if bname == blank -%}{% continue %}{%- endif -%}
            {%- assign bhost = parts[1] | strip -%}
            {%- assign blogo = parts[2] | strip -%}
            {%- if blogo == '-' -%}
              {%- assign logo_src = '' -%}
            {%- elsif blogo != blank -%}
              {%- assign logo_src = blogo -%}
            {%- elsif bhost != blank -%}
              {%- assign logo_src = 'https://www.google.com/s2/favicons?domain=' | append: bhost | append: '&sz=64' -%}
            {%- else -%}
              {%- assign logo_src = '' -%}
            {%- endif -%}
            <a class="hero-marquee-brand" href="{% if bhost != blank %}https://{{ bhost }}{% else %}#{% endif %}" target="_blank" rel="noopener nofollow">
              {%- if logo_src != blank -%}
                <img class="hero-marquee-logo" src="{{ logo_src | escape }}" alt="" width="22" height="22" loading="lazy" onerror="this.style.display='none'">
              {%- endif -%}
              {{ bname }}
            </a>
            <span class="hero-marquee-sep" aria-hidden="true">·</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
      <div class="hero-marquee-track hero-marquee-track--rev" style="--marquee-speed:{{ section.settings.marquee_speed | times: 1.3 }}s">
        {%- assign brand_lines_rev = section.settings.brands_list | strip | split: nl | reverse -%}
        {%- for i in (1..2) -%}
          {%- for line in brand_lines_rev -%}
            {%- assign parts = line | strip | split: '|' -%}
            {%- assign bname = parts[0] | strip -%}
            {%- if bname == blank -%}{% continue %}{%- endif -%}
            {%- assign bhost = parts[1] | strip -%}
            {%- assign blogo = parts[2] | strip -%}
            {%- if blogo == '-' -%}
              {%- assign logo_src = '' -%}
            {%- elsif blogo != blank -%}
              {%- assign logo_src = blogo -%}
            {%- elsif bhost != blank -%}
              {%- assign logo_src = 'https://www.google.com/s2/favicons?domain=' | append: bhost | append: '&sz=64' -%}
            {%- else -%}
              {%- assign logo_src = '' -%}
            {%- endif -%}
            <a class="hero-marquee-brand" href="{% if bhost != blank %}https://{{ bhost }}{% else %}#{% endif %}" target="_blank" rel="noopener nofollow">
              {%- if logo_src != blank -%}
                <img class="hero-marquee-logo" src="{{ logo_src | escape }}" alt="" width="22" height="22" loading="lazy" onerror="this.style.display='none'">
              {%- endif -%}
              {{ bname }}
            </a>
            <span class="hero-marquee-sep" aria-hidden="true">·</span>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Personal Shopper · Paris" },
    { "type": "textarea", "id": "title", "label": "Titre (une ligne par rangée)", "default": "Paris luxury,\ndelivered to you." },
    { "type": "textarea", "id": "subtitle", "label": "Sous-titre", "default": "Hand-picked from Paris outlets, shipped worldwide with care." },
    { "type": "text", "id": "cta_label", "label": "CTA", "default": "Explore the collection" },
    { "type": "url", "id": "cta_link", "label": "Lien du CTA" },
    {
      "type": "header",
      "content": "Fond produits"
    },
    { "type": "checkbox", "id": "show_products_bg", "label": "Produits qui défilent en fond", "default": true },
    { "type": "collection", "id": "bg_collection", "label": "Collection (vide = tous les produits)" },
    {
      "type": "header",
      "content": "Bandeau de marques"
    },
    { "type": "checkbox", "id": "show_brands_marquee", "label": "Afficher le ruban de marques", "default": true },
    { "type": "range", "id": "marquee_speed", "min": 40, "max": 180, "step": 5, "unit": "s", "label": "Vitesse du ruban (plus haut = plus lent)", "default": 100 },
