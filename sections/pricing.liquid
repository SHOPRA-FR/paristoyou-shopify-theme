{%- comment -%}
  Pricing + SIMULATEUR de commission.
  Barème : {{ settings.commission_rate }}% du montant des achats,
  minimum {{ settings.commission_min }} €. Pas de minimum d'achat.
  Le simulateur (assets/theme.js) lit les data-attributes ci-dessous.
{%- endcomment -%}

<section class="section pricing-section" id="pricing"
  data-sim-rate="{{ settings.commission_rate | default: 20 }}"
  data-sim-min="{{ settings.commission_min | default: 300 }}"
  data-night-price="{{ section.settings.night_price | default: 150 }}"
  data-save-label="{{ section.settings.save_label | escape }}"
  data-save-suffix="{{ section.settings.save_suffix | escape }}">
  <div class="container">
    {%- if section.settings.kicker != blank -%}<p class="kicker center accent">{{ section.settings.kicker }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="center">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.subtitle != blank -%}<p class="lead center">{{ section.settings.subtitle }}</p>{%- endif -%}

    <div class="pricing-grid{% unless section.settings.show_simulator %} pricing-grid--solo{% endunless %}">
      <div class="pricing-main">
        <div class="price-hero">
          <span class="price-big">{{ settings.commission_rate }}%</span>
          <span class="price-label">{{ section.settings.rate_label }}</span>
          {%- if section.settings.rate_note != blank -%}<p class="price-incl">{{ section.settings.rate_note }}</p>{%- endif -%}
        </div>

        {%- assign inc = section.settings.included | strip | split: '|' -%}
        {%- if inc.first != blank -%}
          <ul class="fee-included">
            {%- for i in inc -%}{%- assign it = i | strip -%}{%- if it != blank -%}<li>{{ it }}</li>{%- endif -%}{%- endfor -%}
          </ul>
        {%- endif -%}

        {%- assign exs = section.settings.example_amounts | default: '500,1500,3000' | split: ',' -%}
        {%- if exs.first != blank -%}
          {%- assign r = settings.commission_rate | default: 20 | plus: 0 -%}
          {%- assign m = settings.commission_min | default: 300 | plus: 0 -%}
          <div class="fee-examples">
            {%- for a in exs -%}
              {%- assign amt = a | strip | plus: 0 -%}
              {%- assign c = amt | times: r | divided_by: 100 -%}
              {%- if c < m -%}{%- assign c = m -%}{%- endif -%}
              <div class="fee-ex"><span>{{ section.settings.ex_prefix }} {{ amt }} €</span><strong>{{ section.settings.ex_fee_prefix }} {{ c }} €</strong></div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="price-list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}{% if block.settings.muted %} class="muted"{% endif %}>
                <span>{{ block.settings.label }}</span><strong>{{ block.settings.value }}</strong>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- if section.settings.show_simulator -%}
      <aside class="sim-card">
        <h3>{{ section.settings.sim_title }}</h3>
        <input type="range" id="SimAmount" min="0" max="10000" step="100" value="1500" aria-label="{{ section.settings.sim_label }}">
        <div class="sim-amount-val"><span id="SimAmountVal">1 500 €</span></div>
        <div class="sim-rows">
          <div class="sim-row"><span>{{ section.settings.sim_purchases }}</span><strong id="SimPurchases">—</strong></div>
          <div class="sim-row"><span id="SimCommissionLabel">{{ section.settings.sim_commission }}</span><strong id="SimCommission">—</strong></div>
          <div class="sim-row sim-total"><span>{{ section.settings.sim_total }}</span><strong id="SimTotal">—</strong></div>
        </div>

        {%- if section.settings.show_travel -%}
        <div class="sim-divider"><span>{{ section.settings.travel_title }}</span></div>
        <div class="sim-slider-row">
          <label for="SimFlight">{{ section.settings.flight_label }}</label>
          <strong id="SimFlightVal">—</strong>
        </div>
        <input type="range" id="SimFlight" min="0" max="2000" step="10" value="{{ section.settings.flight_default | default: 300 }}">
        <div class="sim-slider-row">
          <label for="SimNights">{{ section.settings.hotel_label }} · <span id="SimNightsN">{{ section.settings.nights_default | default: 3 }}</span> × {{ section.settings.night_price | default: 150 }} €</label>
          <strong id="SimHotelVal">—</strong>
        </div>
        <input type="range" id="SimNights" min="0" max="14" step="1" value="{{ section.settings.nights_default | default: 3 }}">
        <div class="sim-row"><span>{{ section.settings.travel_total_label }}</span><strong id="SimTravel">—</strong></div>
        <div class="sim-save" id="SimSave" hidden></div>
        {%- endif -%}

        <p class="sim-note">{{ section.settings.sim_note }}</p>
      </aside>
      {%- endif -%}
    </div>

    {%- if section.settings.show_versus -%}
    <div class="versus-strip">
      <p class="versus-title">{{ section.settings.jeans_title }}</p>
      <div class="versus-tiles">
        <div class="versus-tile">
          <span class="v-label">{{ section.settings.jeans_l1 }}</span>
          <strong>{{ section.settings.jeans_v1 }}</strong>
          <span class="v-note">{{ section.settings.jeans_n1 }}</span>
        </div>
        <div class="versus-tile">
          <span class="v-label">{{ section.settings.jeans_l2 }}</span>
          <strong>{{ section.settings.jeans_v2 }}</strong>
          <span class="v-note">{{ section.settings.jeans_n2 }}</span>
        </div>
        <div class="versus-tile is-me">
          <span class="v-label">{{ section.settings.jeans_l3 }}</span>
          <strong>{{ section.settings.jeans_v3 }}</strong>
          <span class="v-note">{{ section.settings.jeans_n3 }}</span>
        </div>
      </div>
    </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pricing + simulator",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pricing" },
    { "type": "text", "id": "title", "label": "Title", "default": "Simple, transparent pricing" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "20% commission on your purchases (minimum 300 €), and no minimum spend. That commission covers the outlet trips, the scouting, the photos, the packing and the shipping — nothing hidden." },
    { "type": "text", "id": "rate_label", "label": "Rate label", "default": "commission on your purchases" },
    { "type": "textarea", "id": "included", "label": "What's included (separate with |)", "default": "Outlet trips & in-store scouting|Real-time photos & a quick debrief before I buy|Secure packing & tracked shipping|One person, start to finish" },
    { "type": "text", "id": "example_amounts", "label": "Example amounts (comma-separated €)", "default": "500,1500,3000" },
    { "type": "text", "id": "ex_prefix", "label": "Example — amount prefix", "default": "You spend" },
    { "type": "text", "id": "ex_fee_prefix", "label": "Example — commission prefix", "default": "commission" },
    { "type": "textarea", "id": "rate_note", "label": "Rate note", "default": "Minimum commission 300 €. No minimum purchase. Includes outlet trips, in-store scouting, photos & phone debrief, secure packing and shipment handling." },
    { "type": "checkbox", "id": "show_simulator", "label": "Show commission simulator", "default": true },
    { "type": "checkbox", "id": "show_travel", "label": "Show travel comparison inside simulator", "default": true },
    { "type": "checkbox", "id": "show_versus", "label": "Show versus comparison tiles", "default": true },
    { "type": "text", "id": "sim_title", "label": "Simulator title", "default": "Commission simulator" },
    { "type": "text", "id": "sim_label", "label": "Simulator input label", "default": "Amount of your purchases (€)" },
    { "type": "text", "id": "sim_purchases", "label": "Purchases row label", "default": "Your purchases" },
    { "type": "text", "id": "sim_commission", "label": "Commission row label", "default": "My commission" },
    { "type": "text", "id": "sim_total", "label": "Total row label", "default": "Estimated total" },
    { "type": "textarea", "id": "sim_note", "label": "Simulator note", "default": "Indicative estimate before delivery. A firm quote is validated together before any deposit." },
    { "type": "header", "content": "Travel comparison" },
    { "type": "text", "id": "travel_title", "label": "Divider title", "default": "vs. a shopping trip to Paris" },
    { "type": "text", "id": "flight_label", "label": "Flight slider label", "default": "Round-trip flight" },
    { "type": "range", "id": "flight_default", "min": 0, "max": 1000, "step": 50, "unit": "€", "label": "Flight default", "default": 300 },
    { "type": "text", "id": "hotel_label", "label": "Hotel slider label", "default": "Hotel nights" },
    { "type": "range", "id": "nights_default", "min": 0, "max": 10, "step": 1, "label": "Nights default", "default": 3 },
    { "type": "range", "id": "night_price", "min": 50, "max": 400, "step": 10, "unit": "€", "label": "Price per night", "default": 150 },
    { "type": "text", "id": "travel_total_label", "label": "Travel total label", "default": "Trip cost you avoid" },
    { "type": "text", "id": "save_label", "label": "Savings label", "default": "You save" },
    { "type": "text", "id": "save_suffix", "label": "Savings suffix", "default": "vs travelling to Paris yourself — plus the visa, the week off and the restaurants." },
    { "type": "header", "content": "Real example (jeans)" },
    { "type": "text", "id": "jeans_title", "label": "Example title", "default": "Real example — the same designer jeans" },
    { "type": "text", "id": "jeans_l1", "label": "Tile 1 label", "default": "In Turkey (import taxes)" },
    { "type": "text", "id": "jeans_v1", "label": "Tile 1 value", "default": "180 €" },
    { "type": "text", "id": "jeans_n1", "label": "Tile 1 note", "default": "typical local price" },
    { "type": "text", "id": "jeans_l2", "label": "Tile 2 label", "default": "Europe boutique price" },
    { "type": "text", "id": "jeans_v2", "label": "Tile 2 value", "default": "100 €" },
    { "type": "text", "id": "jeans_n2", "label": "Tile 2 note", "default": "regular retail" },
    { "type": "text", "id": "jeans_l3", "label": "Tile 3 label", "default": "My outlet price" },
    { "type": "text", "id": "jeans_v3", "label": "Tile 3 value", "default": "50 – 70 €" },
    { "type": "text", "id": "jeans_n3", "label": "Tile 3 note", "default": "−30% to −50% in boutique" }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Price row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Label" },
        { "type": "text", "id": "value", "label": "Value", "default": "Value" },
        { "type": "checkbox", "id": "muted", "label": "Muted style", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing + simulator",
      "blocks": [
        { "type": "row", "settings": { "label": "Minimum purchase", "value": "None" } },
        { "type": "row", "settings": { "label": "Minimum commission", "value": "300 €" } },
        { "type": "row", "settings": { "label": "Deposit", "value": "Purchases + provisional commission, validated together" } },
        { "type": "row", "settings": { "label": "Delivery", "value": "Tracked parcel · Europe & worldwide" } },
        { "type": "row", "settings": { "label": "Destination customs duties", "value": "client's responsibility", "muted": true } }
      ]
    }
  ]
}
{% endschema %}
