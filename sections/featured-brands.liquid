{%- comment -%}
  The selection — vrais produits Shopify dans le carousel (image, marque, nom, prix).
  Collection optionnelle ; sinon tous les produits. Fini les placeholders.
{%- endcomment -%}

{%- assign coll = section.settings.collection -%}
{%- if coll == blank -%}{%- assign coll = collections.all -%}{%- endif -%}

<section class="section" id="selection">
  <div class="container">
    {%- if section.settings.kicker != blank -%}<p class="kicker center">{{ section.settings.kicker }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="center">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.subtitle != blank -%}<p class="lead center">{{ section.settings.subtitle }}</p>{%- endif -%}
  </div>

  {%- assign sel_count = coll.products_count | default: 0 | plus: 0 -%}
  {%- if sel_count > 0 -%}
    <div class="sel-carousel" id="SelCarousel" data-speed="{{ section.settings.carousel_speed }}">
      <div class="sel-track" id="SelTrack">
        {%- for product in coll.products limit: section.settings.count -%}
          <article class="sel-card">
            <a href="{{ product.url }}" class="sel-media">
              {%- if product.featured_image -%}
                <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title | escape }}" width="800" height="800" loading="lazy">
              {%- else -%}
                <div class="cat-noimg"><span>📷</span></div>
              {%- endif -%}
              {%- if product.compare_at_price > product.price -%}
                {%- assign pct = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round -%}
                <span class="sel-badge">−{{ pct }}%</span>
              {%- endif -%}
            </a>
            <div class="sel-info">
              {%- if product.vendor != blank -%}<span class="sel-brand">{{ product.vendor }}</span>{%- endif -%}
              <span class="sel-item">{{ product.title }}</span>
              <span class="sel-price">
                {%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                {{ product.price | money }}
              </span>
              <span class="sel-link">{{ section.settings.card_cta }}</span>
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  {%- else -%}
    <div class="container"><p class="offers-note center">{{ section.settings.empty_note }}</p></div>
  {%- endif -%}

  {%- if section.settings.cta_label != blank -%}
    <div class="container"><p class="center sel-cta"><a href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}" class="btn btn-dark">{{ section.settings.cta_label }}</a></p></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Selection (products)",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "The selection" },
    { "type": "text", "id": "title", "label": "Title", "default": "Handpicked, at outlet price" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "A glimpse of what I find in the Paris outlets. Ask for any of these — or anything similar." },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Empty = all products. Point to a curated collection (e.g. flagships) to highlight specific pieces." },
    { "type": "range", "id": "count", "min": 4, "max": 16, "step": 1, "label": "Number of products", "default": 10 },
    { "type": "range", "id": "carousel_speed", "min": 1, "max": 8, "step": 1, "unit": "s", "label": "Pause between cards (seconds)", "default": 2 },
    { "type": "text", "id": "card_cta", "label": "Card link label", "default": "View & order →" },
    { "type": "text", "id": "empty_note", "label": "Empty note", "default": "Selection coming soon." },
    { "type": "text", "id": "cta_label", "label": "Bottom CTA label", "default": "Browse the full catalog" },
    { "type": "url", "id": "cta_link", "label": "Bottom CTA link" }
  ],
  "presets": [{ "name": "Selection (products)" }]
}
{% endschema %}
