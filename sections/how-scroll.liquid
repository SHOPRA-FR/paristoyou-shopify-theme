{%- comment -%}
  How it works — scrollytelling façon Apple : la section reste épinglée à
  l'écran et les étapes (texte + image) se succèdent au fil du scroll, avec
  une barre de progression pilotée par la position de défilement.
  Dégradation : sans JS ou avec prefers-reduced-motion, les étapes s'affichent
  empilées normalement (aucune classe .hs-ready posée).

  Images : renseigner `image_asset` (fichier dans assets/, ex. how-1.jpg) → fait
  partie du thème, ne disparaît jamais lors d'un update. image_picker = repli.
  Illustrations paysage sur fond cream → object-fit:contain, aucune découpe.
{%- endcomment -%}

{%- assign steps = section.blocks | where: 'type', 'step' -%}

<section class="hs-scrolly" id="HS-{{ section.id }}" data-count="{{ steps.size }}"
         style="--hs-step:{{ section.settings.step_vh }}vh">
  <div class="hs-track">
    <div class="hs-stage">
      <div class="container hs-inner">
        <header class="hs-head">
          {%- if section.settings.kicker != blank -%}<p class="kicker center">{{ section.settings.kicker }}</p>{%- endif -%}
          <h2 class="center">{{ section.settings.title }}</h2>
        </header>

        <div class="hs-cols">
          <div class="hs-copy">
            {%- for block in steps -%}
              <div class="hs-step{% if forloop.first %} is-active{% endif %}" data-idx="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
                <span class="hs-num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                {%- if block.settings.benefit != blank -%}<p class="hs-benefit">{{ block.settings.benefit }}</p>{%- endif -%}
                <h3>{{ block.settings.title }}</h3>
                <p class="hs-text">{{ block.settings.text }}</p>
              </div>
            {%- endfor -%}
          </div>

          <div class="hs-visual">
            {%- for block in steps -%}
              <div class="hs-img{% if forloop.first %} is-active{% endif %}" data-idx="{{ forloop.index0 }}">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 1400 }}"
                       srcset="{{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1400 }} 1400w"
                       sizes="(max-width: 760px) 92vw, 46vw"
                       alt="{{ block.settings.image.alt | default: block.settings.title | escape }}"
                       width="1400" height="{{ 1400 | divided_by: block.settings.image.aspect_ratio | round }}"
                       loading="lazy">
                {%- elsif block.settings.image_asset != blank -%}
                  <img src="{{ block.settings.image_asset | asset_url }}"
                       alt="{{ block.settings.title | escape }}"
                       width="1400" height="763" loading="lazy">
                {%- else -%}
                  <div class="hs-ph"><span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span></div>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        </div>

        <div class="hs-progress" aria-hidden="true">
          <span class="hs-counter" id="HSCounter-{{ section.id }}">01</span>
          <span class="hs-bar"><span class="hs-bar-fill" id="HSBar-{{ section.id }}"></span></span>
          <span class="hs-total">{{ steps.size | prepend: '0' | slice: -2, 2 }}</span>
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
.hs-scrolly{position:relative}
.hs-head{margin-bottom:clamp(28px,4vh,52px);padding-top:clamp(40px,6vh,80px)}
.hs-inner{padding-top:clamp(60px,9vh,110px);padding-bottom:clamp(28px,5vh,56px)}
.hs-cols{display:grid;grid-template-columns:1fr 1fr;gap:clamp(32px,6vw,80px);align-items:center}

/* Étape (texte) */
.hs-step{max-width:420px}
.hs-num{display:block;font-family:"Playfair Display",Georgia,serif;font-size:3rem;font-weight:500;color:rgba(0,0,0,.08);line-height:1;margin-bottom:14px}
.hs-benefit{display:inline-block;font-size:.64rem;font-weight:400;text-transform:uppercase;letter-spacing:.18em;color:#b8944a;border-bottom:1px solid rgba(184,148,74,.4);padding-bottom:4px;margin-bottom:14px}
.hs-step h3{font-family:"Playfair Display",Georgia,serif;font-size:clamp(1.5rem,2.6vw,2rem);font-weight:500;margin-bottom:12px}
.hs-text{font-size:.93rem;color:var(--muted);font-weight:300;line-height:1.7}

/* Image — illustrations paysage sur fond cream : contain, jamais rognées */
.hs-img img,.hs-ph{width:100%;height:auto;display:block;border-radius:0 40px 0 0}
.hs-ph{aspect-ratio:11/6;background:color-mix(in srgb,var(--bg) 76%,#D8D0C5 24%);display:flex;align-items:center;justify-content:center}
.hs-ph span{font-family:"Playfair Display",Georgia,serif;font-size:4rem;color:rgba(0,0,0,.08)}

/* Progression */
.hs-progress{display:none;align-items:center;gap:14px;margin-top:clamp(20px,4vh,40px);max-width:280px}
.hs-counter,.hs-total{font-family:"Playfair Display",Georgia,serif;font-size:.92rem;color:var(--text)}
.hs-total{color:var(--muted)}
.hs-bar{flex:1;height:1px;background:rgba(0,0,0,.1);position:relative;overflow:hidden}
.hs-bar-fill{position:absolute;inset:0;background:#b8944a;transform:scaleX(0);transform-origin:left center}

/* ---- Mode statique (défaut : sans JS / reduced motion) ---- */
.hs-scrolly:not(.hs-ready) .hs-cols{display:flex;flex-direction:column;gap:64px}
.hs-scrolly:not(.hs-ready) .hs-copy{display:flex;flex-direction:column;gap:64px}
.hs-scrolly:not(.hs-ready) .hs-visual{display:none}
.hs-scrolly:not(.hs-ready) .hs-step{display:grid;grid-template-columns:1fr;gap:0;max-width:560px;margin:0 auto;text-align:center}
.hs-scrolly:not(.hs-ready) .hs-step .hs-num{margin-left:auto;margin-right:auto}

/* ---- Mode scrollytelling (JS actif) ---- */
.hs-ready .hs-track{height:calc(var(--hs-count,3) * var(--hs-step,150vh))}
.hs-ready .hs-stage{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden;display:flex;align-items:center}
.hs-ready .hs-inner{width:100%;padding-top:clamp(96px,14vh,140px);padding-bottom:28px}
.hs-ready .hs-copy,.hs-ready .hs-visual{position:relative}
.hs-ready .hs-copy{min-height:300px}
.hs-ready .hs-visual{aspect-ratio:11/6;max-height:52vh;background:var(--bg);border-radius:0 40px 0 0;overflow:hidden}
.hs-ready .hs-step,.hs-ready .hs-img{position:absolute;inset:0}
.hs-ready .hs-step{display:flex;flex-direction:column;justify-content:center;opacity:0;transform:translateY(36px);transition:opacity .55s ease,transform .55s cubic-bezier(.23,1,.32,1);pointer-events:none}
.hs-ready .hs-step.is-active{opacity:1;transform:translateY(0);pointer-events:auto}
.hs-ready .hs-step.is-past{opacity:0;transform:translateY(-36px)}
.hs-ready .hs-step.is-active .hs-num{color:rgba(0,0,0,.16);transition:color .6s ease}
.hs-ready .hs-img{opacity:0;transform:scale(1.05) translateY(18px);transition:opacity .6s ease,transform .7s cubic-bezier(.23,1,.32,1)}
.hs-ready .hs-img.is-active{opacity:1;transform:scale(1) translateY(0)}
.hs-ready .hs-img.is-past{opacity:0;transform:scale(.985) translateY(-18px)}
.hs-ready .hs-img img,.hs-ready .hs-ph{height:100%;object-fit:contain}
.hs-ready .hs-progress{display:flex}

@media (max-width:760px){
  .hs-cols{grid-template-columns:1fr;gap:20px}
  .hs-ready .hs-stage{align-items:flex-start}
  .hs-ready .hs-inner{padding-top:max(100px,13svh)}
  .hs-ready .hs-visual{order:1;aspect-ratio:11/6;height:auto;max-height:34svh}
  .hs-ready .hs-copy{order:2;min-height:240px}
  .hs-ready .hs-step{justify-content:flex-start}
  .hs-num{font-size:2.2rem;margin-bottom:10px}
  .hs-head{margin-bottom:18px}
}
{% endstyle %}

<script>
(function () {
  "use strict";
  var scrolly = document.getElementById('HS-{{ section.id }}');
  if (!scrolly) return;
  var count = parseInt(scrolly.dataset.count || '0', 10);
  if (count < 2) return;
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

  var track = scrolly.querySelector('.hs-track');
  var steps = [].slice.call(scrolly.querySelectorAll('.hs-step'));
  var imgs = [].slice.call(scrolly.querySelectorAll('.hs-img'));
  var bar = document.getElementById('HSBar-{{ section.id }}');
  var counter = document.getElementById('HSCounter-{{ section.id }}');

  scrolly.style.setProperty('--hs-count', count);
  scrolly.classList.add('hs-ready');

  var current = -1;
  var ticking = false;

  function setActive(idx) {
    if (idx === current) return;
    current = idx;
    steps.forEach(function (el, i) {
      el.classList.toggle('is-active', i === idx);
      el.classList.toggle('is-past', i < idx);
    });
    imgs.forEach(function (el, i) {
      el.classList.toggle('is-active', i === idx);
      el.classList.toggle('is-past', i < idx);
    });
    if (counter) counter.textContent = ('0' + (idx + 1)).slice(-2);
  }

  function update() {
    ticking = false;
    var r = track.getBoundingClientRect();
    var vh = window.innerHeight;
    var total = r.height - vh;
    if (total <= 0) { setActive(0); return; }
    var p = Math.min(1, Math.max(0, -r.top / total));
    setActive(Math.min(count - 1, Math.floor(p * count)));
    if (bar) bar.style.transform = 'scaleX(' + p + ')';
  }

  function onScroll() {
    if (!ticking) { ticking = true; requestAnimationFrame(update); }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
  update();

  {%- if request.design_mode -%}
  // Éditeur de thème : afficher l'étape du bloc sélectionné
  document.addEventListener('shopify:block:select', function (e) {
    var step = e.target.closest ? e.target.closest('.hs-step') : null;
    if (step && step.dataset.idx) setActive(parseInt(step.dataset.idx, 10));
  });
  {%- endif -%}
})();
</script>

{% schema %}
{
  "name": "How it works — scrolly",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How it works" },
    { "type": "text", "id": "title", "label": "Title", "default": "Three simple steps" },
    { "type": "range", "id": "step_vh", "min": 100, "max": 250, "step": 10, "unit": "vh", "label": "Scroll length per step", "default": 150 }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "image_asset", "label": "Image file in assets/ (e.g. how-1.jpg) — never resets on theme update" },
        { "type": "image_picker", "id": "image", "label": "Or upload an image (optional — resets on theme update)" },
        { "type": "text", "id": "benefit", "label": "Benefit tag (short)", "default": "No travel needed" },
        { "type": "text", "id": "title", "label": "Title", "default": "Send your wishlist" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Paste the links of the items you want, with sizes, colors and preferences." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How it works — scrolly",
      "blocks": [
        { "type": "step", "settings": { "image_asset": "how-1.jpg", "benefit": "No travel needed", "title": "Send your wishlist", "text": "Paste the links of the items you want — sizes, colors, budget. Straight from your phone: no visa, no flights, no hotel." } },
        { "type": "step", "settings": { "image_asset": "how-2.jpg", "benefit": "Outlet prices, always", "title": "I scout, you validate", "text": "I go to La Vallée Village & Val d'Europe, send you real-time photos and outlet prices. Nothing is bought without your go." } },
        { "type": "step", "settings": { "image_asset": "how-3.jpg", "benefit": "Delivered worldwide", "title": "We settle & ship", "text": "Final payment, careful packing and tracked Colissimo delivery to your door — Europe, Turkey & beyond." } }
      ]
    }
  ]
}
{% endschema %}
