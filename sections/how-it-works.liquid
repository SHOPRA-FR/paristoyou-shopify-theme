{%- comment -%}
  How it works — Scroll timeline simple (homepage).
{%- endcomment -%}

<section class="section" id="how">
  <div class="container container-narrow">
    {%- if section.settings.kicker != blank -%}
      <p class="kicker center">{{ section.settings.kicker }}</p>
    {%- endif -%}
    {%- if section.settings.title != blank -%}
      <h2 class="center">{{ section.settings.title }}</h2>
    {%- endif -%}

    <div class="timeline" id="Timeline">
      {%- for block in section.blocks -%}
        <div class="timeline-step" {{ block.shopify_attributes }}>
          <div class="timeline-marker">
            <span class="timeline-num">0{{ forloop.index }}</span>
            <span class="timeline-dot"></span>
          </div>
          <div class="timeline-body">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script>
(function(){
  var steps = document.querySelectorAll('#Timeline .timeline-step');
  if (!steps.length) return;

  steps.forEach(function(step, i){
    step.style.transitionDelay = (i * 0.15) + 's';
  });

  var observer = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting){
        entry.target.classList.add('visible');
      }
    });
  }, { threshold: 0.2, rootMargin: '0px 0px -40px 0px' });

  steps.forEach(function(step){ observer.observe(step); });
})();
</script>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How it works" },
    { "type": "text", "id": "title", "label": "Title", "default": "Three simple steps" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe the step." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Send your wishlist", "text": "Paste the links of the items you want, with sizes, colors and preferences. Everything stays saved on your account." } },
        { "type": "step", "settings": { "title": "I scout, you validate", "text": "I go to the Paris outlets, send you real-time photos and prices of each item found. You validate before I buy — total control." } },
        { "type": "step", "settings": { "title": "We settle & ship", "text": "Final payment after validation, then careful packing and tracked Colissimo delivery to your address — Europe & worldwide." } }
      ]
    }
  ]
}
{% endschema %}
