<section class="section" id="how">
  <div class="container">
    {%- if section.settings.kicker != blank -%}<p class="kicker center">{{ section.settings.kicker }}</p>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="center">{{ section.settings.title }}</h2>{%- endif -%}
    <div class="steps cols-{{ section.blocks.size | at_most: 6 }}">
      {%- for block in section.blocks -%}
        <article class="step" {{ block.shopify_attributes }}>
          <div class="step-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "How it works" },
    { "type": "text", "id": "title", "label": "Title", "default": "Six simple steps" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Step" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe the step." }
      ]
    }
  ],
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "title": "Create your account", "text": "Sign up with your delivery address and contact details — everything stays saved for your orders." } },
        { "type": "step", "settings": { "title": "Send your shopping list", "text": "Build your list on the My List page: paste the links of the items you want, with sizes and prices." } },
        { "type": "step", "settings": { "title": "Pay the deposit", "text": "A deposit matching the estimated total of your shopping + my provisional fee, validated together." } },
        { "type": "step", "settings": { "title": "Book a call", "text": "Tell me your date and time availability for a phone exchange about your list." } },
        { "type": "step", "settings": { "title": "I scout, you validate, I buy", "text": "After our call I go to the boutiques, report back on the items found matching your request — and buy them upon your validation." } },
        { "type": "step", "settings": { "title": "Tracked delivery", "text": "Carefully packed and shipped with tracking to the address from your account — Europe & worldwide." } }
      ]
    }
  ]
}
{% endschema %}
